---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { templates } from '../data/templates';
import { topicMap } from '../data/topics';

const steps = [
  { n: '01', title: 'Copy the template', text: 'Plain text. No login, no watermark, no “download PDF” wall.' },
  { n: '02', title: 'Fill every bracket', text: 'Dates, amounts, order numbers, addresses. Specific beats emotional.' },
  { n: '03', title: 'Send it, keep it', text: 'Email or registered post. Save the sent copy and the acknowledgement.' },
];
---

<BaseLayout
  title="The toolkit"
  description="Six copy-ready letters and complaints for Indian consumers, tenants, workers, and citizens — written to be read, not ignored."
>
  <header class="toolkit-head">
    <div class="container">
      <p class="eyebrow">The toolkit · Six documents</p>
      <div class="toolkit-head__grid">
        <div>
          <h1>Say it<br /><span class="italic">in writing.</span></h1>
          <p class="toolkit-head__lede">
            A phone call disappears. A letter creates a date, a demand, and a record. These are the
            six documents people most often need — and should not have to draft from scratch.
          </p>
        </div>
        <div class="toolkit-head__note">
          <span class="stamp">Copy-ready</span>
          <p>Every template is plain text. Adapt the facts, keep the structure, send it.</p>
          <span class="toolkit-head__note-meta">No account · No paywall · Free to reuse</span>
        </div>
      </div>
    </div>
    <span class="toolkit-head__mark" aria-hidden="true">¶</span>
  </header>

  <section class="how">
    <div class="container how__grid">
      {
        steps.map((step) => (
          <div class="how__step">
            <span class="how__num">{step.n}</span>
            <h2>{step.title}</h2>
            <p>{step.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="toolkit-body">
    <div class="container toolkit-layout">
      <aside class="toolkit-rail">
        <div class="toolkit-rail__head">
          <h2>Choose a document</h2>
          <span>{String(templates.length).padStart(2, '0')}</span>
        </div>

        <div class="toolkit-rail__list" role="tablist" aria-label="Templates" aria-orientation="vertical">
          {
            templates.map((template, i) => {
              const topic = topicMap[template.topic];
              return (
                <button
                  type="button"
                  role="tab"
                  id={`template-tab-${template.id}`}
                  aria-controls={`template-panel-${template.id}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? 0 : -1}
                  class:list={['rail-item', { 'is-active': i === 0 }]}
                  data-template-tab={template.id}
                  style={`--topic:${topic.color}`}
                >
                  <span class="rail-item__num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="rail-item__main">
                    <span class="rail-item__title">{template.title}</span>
                    <span class="rail-item__topic">{topic.name}</span>
                  </span>
                  <Icon name="arrow" size={16} class="rail-item__arrow" />
                </button>
              );
            })
          }
        </div>

        <div class="toolkit-rail__note">
          <Icon name="warning" size={16} />
          <p>
            A template is a starting point, not legal advice. Check the limitation period and the
            right forum for your facts.
          </p>
        </div>
      </aside>

      <div class="toolkit-panels">
        {
          templates.map((template, i) => {
            const topic = topicMap[template.topic];
            return (
              <article
                class="template"
                id={`template-panel-${template.id}`}
                role="tabpanel"
                aria-labelledby={`template-tab-${template.id}`}
                data-template-panel={template.id}
                hidden={i !== 0}
                style={`--topic:${topic.color};--wash:${topic.wash}`}
              >
                <div class="template__head">
                  <div class="template__title-row">
                    <span class="template__topic">{topic.name}</span>
                    <span class="template__num">{String(i + 1).padStart(2, '0')} / {String(templates.length).padStart(2, '0')}</span>
                  </div>
                  <h2>{template.title}</h2>
                  <p class="template__use">
                    <strong>Use when:</strong> {template.useWhen}
                  </p>
                </div>

                <div class="template__actions">
                  <button type="button" class="btn btn--sm" data-copy-template>
                    <Icon name="copy" size={15} />
                    <span data-copy-label>Copy template</span>
                  </button>
                  <button type="button" class="btn btn--ghost btn--sm" data-print-template>
                    <Icon name="document" size={15} /> Print
                  </button>
                  <span class="template__hint">Brackets are placeholders — fill or delete them.</span>
                </div>

                <div class="template__paper">
                  <div class="template__subject">
                    <span>Subject</span>
                    <p>{template.subject}</p>
                  </div>
                  <pre class="template__body" data-copy-body>{template.body}</pre>
                </div>

                <div class="template__tips">
                  <h3>Before you send</h3>
                  <ul role="list">
                    {template.tips.map((tip) => (
                      <li>
                        <Icon name="check" size={14} />
                        <span>{tip}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <p class="template__disclaimer">
                  <Icon name="info" size={14} />
                  General information, not legal advice. See the <a href="/law-simplified/disclaimer">disclaimer</a>.
                </p>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="toolkit-close">
    <div class="container toolkit-close__inner">
      <div>
        <p class="eyebrow eyebrow--light">One more thing</p>
        <h2>The paper trail is the point.</h2>
        <p>
          Keep a folder — digital or physical — with the agreement, the invoice, the messages, the
          receipts, and every letter you send. A clear chronology is often worth more than a clever
          argument.
        </p>
      </div>
      <a class="btn btn--paper" href="/law-simplified/guides">Read the matching guide <Icon name="arrow" size={17} /></a>
    </div>
  </section>
</BaseLayout>

<style>
  .toolkit-head {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1.5px solid var(--ink);
    background:
      radial-gradient(circle at 85% 20%, rgba(31, 60, 255, 0.08), transparent 28%),
      var(--paper);
  }

  .toolkit-head__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: end;
    margin-top: 1rem;
  }

  .toolkit-head h1 {
    font-size: clamp(3rem, 8vw, 6.4rem);
    line-height: 0.88;
    letter-spacing: -0.055em;
  }

  .toolkit-head__lede {
    max-width: 38rem;
    margin-top: 1.4rem;
    font-size: clamp(1rem, 0.96rem + 0.35vw, 1.2rem);
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .toolkit-head__note {
    max-width: 17rem;
    padding: 1.1rem 1.2rem;
    background: var(--paper-bright);
    border: 1px solid var(--line-strong);
    border-top: 3px solid var(--blue);
    box-shadow: 5px 5px 0 var(--line);
    transform: rotate(1deg);
  }

  .toolkit-head__note .stamp {
    color: var(--blue);
    font-size: 0.55rem;
    padding: 0.3rem 0.45rem;
  }

  .toolkit-head__note p {
    margin-top: 0.7rem;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .toolkit-head__note-meta {
    display: block;
    margin-top: 0.7rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-ui);
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .toolkit-head__mark {
    position: absolute;
    right: 3%;
    bottom: -0.3em;
    font-family: var(--font-body);
    font-size: clamp(10rem, 24vw, 22rem);
    line-height: 1;
    color: var(--blue);
    opacity: 0.05;
    pointer-events: none;
    user-select: none;
  }

  .how {
    border-bottom: 1px solid var(--line-strong);
    background: var(--paper-deep);
  }

  .how__grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  .how__step {
    padding: 1.3rem 0;
    border-bottom: 1px solid var(--line);
  }

  .how__step:last-child {
    border-bottom: 0;
  }

  .how__num {
    font-family: var(--font-ui);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--red);
  }

  .how__step h2 {
    margin-top: 0.3rem;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }

  .how__step p {
    margin-top: 0.3rem;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .toolkit-body {
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(3rem, 6vw, 5rem);
  }

  .toolkit-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  .toolkit-rail {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .toolkit-rail__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.7rem;
    border-bottom: 1.5px solid var(--ink);
  }

  .toolkit-rail__head h2 {
    font-family: var(--font-ui);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .toolkit-rail__head span {
    font-family: var(--font-ui);
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--red);
  }

  .toolkit-rail__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.3rem;
  }

  .rail-item {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.7rem 0.65rem;
    border: 1px solid transparent;
    border-left: 3px solid transparent;
    text-align: left;
    transition:
      background 0.15s ease,
      border-color 0.15s ease;
  }

  .rail-item:hover {
    background: var(--paper-bright);
    border-color: var(--line);
  }

  .rail-item.is-active {
    background: var(--paper-bright);
    border-color: var(--line-strong);
    border-left-color: var(--topic);
  }

  .rail-item__num {
    font-family: var(--font-ui);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
  }

  .rail-item__main {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    flex: 1;
    min-width: 0;
  }

  .rail-item__title {
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .rail-item__topic {
    font-family: var(--font-ui);
    font-size: 0.56rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--topic);
  }

  .rail-item__arrow {
    flex: none;
    color: var(--ink-soft);
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .rail-item.is-active .rail-item__arrow {
    opacity: 1;
    color: var(--topic);
  }

  .toolkit-rail__note {
    display: flex;
    gap: 0.55rem;
    padding: 0.85rem;
    background: var(--paper-bright);
    border: 1px solid var(--line);
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .toolkit-rail__note svg {
    flex: none;
    margin-top: 0.1rem;
    color: var(--red);
  }

  .template {
    background: var(--paper-bright);
    border: 1px solid var(--line-strong);
    border-top: 4px solid var(--topic);
    box-shadow: 6px 6px 0 var(--line);
  }

  .template[hidden] {
    display: none;
  }

  .template__head {
    padding: clamp(1.2rem, 2.5vw, 1.8rem) clamp(1.2rem, 2.5vw, 1.9rem);
    border-bottom: 1px solid var(--line);
    background: linear-gradient(115deg, var(--wash), transparent 65%);
  }

  .template__title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .template__topic {
    font-family: var(--font-ui);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--topic);
  }

  .template__num {
    font-family: var(--font-ui);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
  }

  .template__head h2 {
    margin-top: 0.5rem;
    font-size: clamp(1.7rem, 1.4rem + 1vw, 2.4rem);
    letter-spacing: -0.04em;
  }

  .template__use {
    max-width: 52rem;
    margin-top: 0.7rem;
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .template__use strong {
    color: var(--ink);
  }

  .template__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem clamp(1.2rem, 2.5vw, 1.9rem);
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }

  .template__hint {
    font-family: var(--font-ui);
    font-size: 0.62rem;
    color: var(--ink-soft);
  }

  .template__paper {
    margin: clamp(1.2rem, 2.5vw, 1.9rem);
    padding: clamp(1.2rem, 2.5vw, 1.9rem);
    border: 1px solid var(--line);
    background:
      linear-gradient(var(--paper-bright), var(--paper-bright)) padding-box,
      repeating-linear-gradient(0deg, transparent 0 27px, rgba(18, 17, 15, 0.045) 27px 28px);
  }

  .template__subject {
    padding-bottom: 0.9rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .template__subject span {
    display: block;
    font-family: var(--font-ui);
    font-size: 0.54rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--red);
  }

  .template__subject p {
    margin-top: 0.25rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .template__body {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.88rem;
    line-height: 1.75;
    color: var(--ink);
    white-space: pre-wrap;
    overflow-wrap: break-word;
    tab-size: 2;
  }

  .template__tips {
    margin: 0 clamp(1.2rem, 2.5vw, 1.9rem) clamp(1.2rem, 2.5vw, 1.9rem);
    padding: 1.1rem 1.2rem;
    background: var(--paper);
    border-left: 3px solid var(--blue);
  }

  .template__tips h3 {
    font-family: var(--font-ui);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue-deep);
  }

  .template__tips ul {
    list-style: none;
    margin: 0.7rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .template__tips li {
    display: flex;
    gap: 0.5rem;
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .template__tips li svg {
    flex: none;
    margin-top: 0.25rem;
    color: var(--green);
  }

  .template__disclaimer {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0 1.9rem 1.2rem;
    font-family: var(--font-ui);
    font-size: 0.6rem;
    color: var(--ink-soft);
  }

  .template__disclaimer a {
    color: var(--blue-deep);
    font-weight: 600;
  }

  .toolkit-close {
    padding-block: clamp(3rem, 6vw, 5rem);
    background: var(--ink);
    color: var(--paper-bright);
  }

  .eyebrow--light {
    color: rgba(255, 253, 245, 0.55);
  }

  .eyebrow--light::before {
    background: var(--paper-bright);
  }

  .toolkit-close__inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: flex-start;
  }

  .toolkit-close h2 {
    margin-top: 0.7rem;
    font-size: clamp(2rem, 4.5vw, 3.6rem);
  }

  .toolkit-close p {
    max-width: 36rem;
    margin-top: 1rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(255, 253, 245, 0.68);
  }

  .copy-feedback {
    color: var(--green);
  }

  @media (min-width: 700px) {
    .toolkit-head__grid {
      grid-template-columns: 1.3fr 0.7fr;
      gap: 3rem;
    }

    .how__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .how__step {
      padding: 1.5rem 1.5rem 1.5rem 0;
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }

    .how__step + .how__step {
      padding-left: 1.5rem;
    }

    .how__step:last-child {
      border-right: 0;
    }

    .toolkit-rail__list {
      grid-template-columns: 1fr 1fr;
    }

    .toolkit-close__inner {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 3rem;
    }
  }

  @media (min-width: 1000px) {
    .toolkit-layout {
      grid-template-columns: 19rem minmax(0, 1fr);
      gap: 3.5rem;
    }

    .toolkit-rail {
      position: sticky;
      top: 7rem;
    }

    .toolkit-rail__list {
      grid-template-columns: 1fr;
    }
  }

  @media print {
    .site-header,
    .footer,
    .toolkit-head,
    .how,
    .toolkit-rail,
    .template__actions,
    .template__tips,
    .template__disclaimer,
    .toolkit-close {
      display: none !important;
    }

    .toolkit-body {
      padding: 0;
    }

    .template {
      border: 0;
      box-shadow: none;
    }

    .template__paper {
      border: 0;
      margin: 0;
      padding: 0;
    }
  }
</style>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-template-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-template-panel]'));

  function activate(id: string, focus = false) {
    tabs.forEach((tab) => {
      const active = tab.dataset.templateTab === id;
      tab.classList.toggle('is-active', active);
      tab.setAttribute('aria-selected', String(active));
      tab.tabIndex = active ? 0 : -1;
      if (active && focus) tab.focus();
    });
    panels.forEach((panel) => {
      panel.hidden = panel.dataset.templatePanel !== id;
    });
    if (history.replaceState) {
      history.replaceState(null, '', `#${id}`);
    }
  }

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => {
      const id = tab.dataset.templateTab;
      if (id) activate(id);
    });

    tab.addEventListener('keydown', (event) => {
      let next = index;
      if (event.key === 'ArrowDown' || event.key === 'ArrowRight') next = (index + 1) % tabs.length;
      else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
      else return;
      event.preventDefault();
      const id = tabs[next].dataset.templateTab;
      if (id) activate(id, true);
    });
  });

  const initial = window.location.hash.replace('#', '');
  if (initial && tabs.some((tab) => tab.dataset.templateTab === initial)) {
    activate(initial);
  }

  document.querySelectorAll<HTMLElement>('[data-template-panel]').forEach((panel) => {
    const copyButton = panel.querySelector<HTMLButtonElement>('[data-copy-template]');
    const printButton = panel.querySelector<HTMLButtonElement>('[data-print-template]');
    const label = panel.querySelector<HTMLElement>('[data-copy-label]');

    copyButton?.addEventListener('click', async () => {
      const body = panel.querySelector<HTMLElement>('[data-copy-body]')?.textContent ?? '';
      const subject = panel.querySelector<HTMLElement>('.template__subject p')?.textContent ?? '';
      const text = `${subject}\n\n${body}`.trim();

      try {
        await navigator.clipboard.writeText(text);
        if (label) {
          label.textContent = 'Copied';
          label.classList.add('copy-feedback');
          window.setTimeout(() => {
            label.textContent = 'Copy template';
            label.classList.remove('copy-feedback');
          }, 2000);
        }
      } catch {
        const range = document.createRange();
        const pre = panel.querySelector('[data-copy-body]');
        if (pre) {
          range.selectNodeContents(pre);
          const selection = window.getSelection();
          selection?.removeAllRanges();
          selection?.addRange(range);
          if (label) label.textContent = 'Select & copy';
        }
      }
    });

    printButton?.addEventListener('click', () => window.print());
  });
</script>
