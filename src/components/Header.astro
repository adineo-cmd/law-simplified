---
import { site } from '../data/site';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="site-header" data-header>
  <div class="utility">
    <div class="container utility__inner">
      <span class="utility__item">
        <span class="utility__dot" aria-hidden="true"></span>
        Independent · India
      </span>
      <span class="utility__item utility__center">General information, not legal advice.</span>
      <span class="utility__item utility__right">
        Free legal aid
        <a href="tel:15100" class="utility__phone">15100</a>
        <span class="utility__sep" aria-hidden="true">/</span>
        <span class="utility__muted">Updated {site.lastReviewed}</span>
      </span>
    </div>
  </div>

  <div class="masthead">
    <div class="container masthead__inner">
      <a href="/" class="wordmark" aria-label={`${site.name} home`}>
        <span>Law, Simplified</span><span class="wordmark__dot">.</span>
      </a>

      <nav class="nav" aria-label="Primary">
        {
          site.nav.map((item) => (
            <a
              href={item.href}
              class:list={['nav__link', { 'is-active': isActive(item.href) }]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="masthead__actions">
        <button type="button" class="search-trigger" data-search-open aria-label="Search guides and glossary">
          <Icon name="search" size={17} />
          <span class="search-trigger__label">Search</span>
          <kbd class="search-trigger__kbd">⌘K</kbd>
        </button>
        <button
          type="button"
          class="menu-trigger"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open menu"
        >
          <Icon name="menu" size={22} />
        </button>
      </div>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <nav aria-label="Mobile">
      <ol>
        {
          site.nav.map((item, i) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                <span class="mobile-menu__num">{String(i + 1).padStart(2, '0')}</span>
                {item.label}
                <Icon name="arrow" size={20} />
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
    <div class="mobile-menu__foot">
      <p>Free legal aid, anywhere in India</p>
      <a href="tel:15100">Call 15100 <Icon name="arrow-up-right" size={15} /></a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .utility {
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-ui);
    font-size: 0.63rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .utility__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.15rem;
  }

  .utility__item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    white-space: nowrap;
  }

  .utility__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--red);
    box-shadow: 0 0 0 3px rgba(229, 72, 47, 0.18);
  }

  .utility__center {
    color: rgba(245, 239, 217, 0.62);
    letter-spacing: 0.1em;
  }

  .utility__right {
    gap: 0.5rem;
  }

  .utility__phone {
    color: var(--paper-bright);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid rgba(245, 239, 217, 0.4);
  }

  .utility__phone:hover {
    border-color: var(--paper-bright);
  }

  .utility__sep,
  .utility__muted {
    color: rgba(245, 239, 217, 0.45);
  }

  .masthead {
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1.5px solid var(--ink);
  }

  .masthead__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.4rem;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.42rem;
    font-weight: 760;
    letter-spacing: -0.045em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark__dot {
    color: var(--red);
  }

  .nav {
    display: none;
    align-items: center;
    gap: clamp(1rem, 2.2vw, 2rem);
  }

  .nav__link {
    position: relative;
    padding: 0.4rem 0;
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 620;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-soft);
    transition: color 0.15s ease;
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.22s var(--ease);
  }

  .nav__link:hover,
  .nav__link.is-active {
    color: var(--ink);
  }

  .nav__link:hover::after,
  .nav__link.is-active::after {
    transform: scaleX(1);
  }

  .masthead__actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 550;
    color: var(--ink-soft);
    transition:
      border-color 0.15s ease,
      color 0.15s ease,
      background 0.15s ease;
  }

  .search-trigger:hover {
    border-color: var(--ink);
    color: var(--ink);
    background: var(--paper-bright);
  }

  .search-trigger__label {
    display: none;
  }

  .search-trigger__kbd {
    display: none;
    padding: 0.1rem 0.3rem;
    border: 1px solid var(--line);
    border-radius: 2px;
    font-family: var(--font-ui);
    font-size: 0.6rem;
    color: var(--ink-soft);
  }

  .menu-trigger {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
  }

  .menu-trigger:hover {
    border-color: var(--ink);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    top: 6.55rem;
    z-index: 99;
    padding: 2rem 1.25rem 2.5rem;
    background: var(--paper);
    border-top: 1px solid var(--line);
    overflow-y: auto;
  }

  .mobile-menu ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-strong);
  }

  .mobile-menu li {
    border-bottom: 1px solid var(--line-strong);
  }

  .mobile-menu li a {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1.05rem 0;
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 650;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .mobile-menu li a svg {
    margin-left: auto;
    color: var(--red);
  }

  .mobile-menu__num {
    font-family: var(--font-ui);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
  }

  .mobile-menu__foot {
    margin-top: 2rem;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    color: var(--ink-soft);
  }

  .mobile-menu__foot a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.35rem;
    font-weight: 650;
    color: var(--ink);
  }

  @media (min-width: 640px) {
    .search-trigger__label,
    .search-trigger__kbd {
      display: inline;
    }

    .search-trigger {
      padding: 0.5rem 0.7rem;
    }
  }

  @media (min-width: 940px) {
    .nav {
      display: flex;
    }

    .menu-trigger {
      display: none;
    }

    .mobile-menu {
      display: none !important;
    }

    .masthead__inner {
      min-height: 4.8rem;
    }

    .wordmark {
      font-size: 1.6rem;
    }
  }

  @media (max-width: 520px) {
    .utility__center,
    .utility__muted,
    .utility__sep {
      display: none;
    }

    .utility__inner {
      justify-content: space-between;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');

  function closeMenu() {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Open menu');
    menu.hidden = true;
    document.documentElement.style.overflow = '';
  }

  toggle?.addEventListener('click', () => {
    if (!menu) return;
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    if (isOpen) {
      closeMenu();
    } else {
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close menu');
      menu.hidden = false;
      document.documentElement.style.overflow = 'hidden';
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });

  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 940) closeMenu();
  });
</script>
