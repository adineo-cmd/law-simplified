---
import Icon from './Icon.astro';
import { topicMap, type TopicId } from '../data/topics';

interface Props {
  id: string;
  title: string;
  dek: string;
  topic: TopicId;
  readTime: number;
  index?: string;
  featured?: boolean;
  class?: string;
}

const { id, title, dek, topic, readTime, index = '01', featured = false, class: className = '' } = Astro.props;
const meta = topicMap[topic];
---

<a
  href={`/guides/${id}/`}
  class:list={['guide-card', { 'guide-card--feature': featured }, className]}
  style={`--topic:${meta.color};--topic-wash:${meta.wash}`}
>
  <div class="guide-card__top">
    <span class="guide-card__index">{index}</span>
    <span class="guide-card__topic">{meta.name}</span>
    <Icon name="arrow-up-right" size={18} class="guide-card__arrow" />
  </div>

  <div class="guide-card__main">
    <h3 class="guide-card__title">{title}</h3>
    <p class="guide-card__dek">{dek}</p>
  </div>

  <div class="guide-card__foot">
    <span class="guide-card__time"><Icon name="clock" size={14} /> {readTime} min read</span>
    <span class="guide-card__cta">Read the guide</span>
  </div>
</a>

<style>
  .guide-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    padding: 1.35rem 1.35rem 1.15rem;
    background: var(--paper-bright);
    border: 1px solid var(--line-strong);
    border-top: 3px solid var(--topic);
    border-radius: var(--radius);
    text-decoration: none;
    overflow: hidden;
    transition:
      transform 0.22s var(--ease),
      box-shadow 0.22s var(--ease),
      background 0.22s var(--ease);
  }

  .guide-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--topic-wash);
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
    z-index: 0;
  }

  .guide-card > * {
    position: relative;
    z-index: 1;
  }

  .guide-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-hard);
  }

  .guide-card:hover::after {
    opacity: 1;
  }

  .guide-card__top {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .guide-card__index {
    font-family: var(--font-ui);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--topic);
  }

  .guide-card__topic {
    font-family: var(--font-ui);
    font-size: 0.62rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .guide-card__arrow {
    margin-left: auto;
    color: var(--ink);
    transition: transform 0.22s var(--ease);
  }

  .guide-card:hover .guide-card__arrow {
    transform: translate(3px, -3px);
  }

  .guide-card__main {
    flex: 1;
  }

  .guide-card__title {
    font-size: clamp(1.35rem, 1.15rem + 0.7vw, 1.75rem);
    font-weight: 680;
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-wrap: balance;
    transition: color 0.18s ease;
  }

  .guide-card:hover .guide-card__title {
    color: var(--topic);
  }

  .guide-card__dek {
    margin-top: 0.65rem;
    font-size: 0.93rem;
    line-height: 1.5;
    color: var(--ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .guide-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-ui);
    font-size: 0.68rem;
    color: var(--ink-soft);
  }

  .guide-card__time {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .guide-card__cta {
    font-weight: 650;
    color: var(--ink);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.2s ease,
      transform 0.2s var(--ease);
  }

  .guide-card:hover .guide-card__cta {
    opacity: 1;
    transform: none;
  }

  .guide-card--feature {
    gap: 2rem;
    padding: clamp(1.5rem, 3vw, 2.4rem);
    border-top-width: 4px;
  }

  .guide-card--feature .guide-card__title {
    font-size: clamp(1.9rem, 1.4rem + 2vw, 3.1rem);
    letter-spacing: -0.045em;
    max-width: 16ch;
  }

  .guide-card--feature .guide-card__dek {
    -webkit-line-clamp: 4;
    font-size: 1rem;
    max-width: 46ch;
  }

  .guide-card--feature .guide-card__cta {
    opacity: 1;
    transform: none;
  }

  @media (min-width: 700px) {
    .guide-card {
      padding: 1.6rem 1.7rem 1.3rem;
    }
  }
</style>
