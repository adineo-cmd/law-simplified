---
import Icon from './Icon.astro';
---

<dialog class="search-dialog" data-search-dialog aria-labelledby="search-title">
  <div class="search-panel">
    <div class="search-head">
      <h2 id="search-title" class="sr-only">Search Law, Simplified</h2>
      <Icon name="search" size={21} class="search-head__icon" />
      <input
        type="search"
        class="search-input"
        placeholder="Search a problem, a term, a template…"
        autocomplete="off"
        spellcheck="false"
        data-search-input
        aria-controls="search-results"
        aria-describedby="search-hint"
      />
      <button type="button" class="search-close" data-search-close aria-label="Close search">
        <kbd>esc</kbd>
        <Icon name="close" size={18} />
      </button>
    </div>

    <div class="search-body">
      <p class="search-label" data-search-label>Start here</p>
      <div class="search-results" id="search-results" data-search-results role="listbox" aria-label="Search results"></div>
      <p class="search-empty" data-search-empty hidden>
        Nothing found for “<span data-search-query></span>”. Try a broader word — “deposit”, “salary”,
        “fraud” — or <a href="/guides">browse every guide</a>.
      </p>
    </div>

    <div class="search-foot" id="search-hint">
      <span><kbd>↑</kbd><kbd>↓</kbd> to move</span>
      <span><kbd>↵</kbd> to open</span>
      <span class="search-foot__brand">Law, Simplified.</span>
    </div>
  </div>
</dialog>

<style>
  .search-dialog {
    width: min(100% - 1.5rem, 720px);
    max-width: none;
    max-height: min(84vh, 760px);
    margin: 7vh auto auto;
    padding: 0;
    background: var(--paper);
    border: 1.5px solid var(--ink);
    border-radius: var(--radius);
    box-shadow: 10px 10px 0 rgba(18, 17, 15, 0.9);
    color: var(--ink);
    overflow: hidden;
  }

  .search-dialog::backdrop {
    background: rgba(18, 17, 15, 0.55);
    backdrop-filter: blur(5px);
  }

  .search-dialog[open] {
    animation: palette-in 0.22s var(--ease);
  }

  @keyframes palette-in {
    from {
      opacity: 0;
      transform: translateY(-10px) scale(0.99);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .search-panel {
    display: flex;
    flex-direction: column;
    max-height: min(84vh, 760px);
  }

  .search-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 1rem 1.1rem;
    border-bottom: 1.5px solid var(--ink);
    background: var(--paper-bright);
  }

  .search-head__icon {
    flex: none;
    color: var(--blue);
  }

  .search-input {
    flex: 1;
    min-width: 0;
    padding: 0.25rem 0;
    border: 0;
    outline: 0;
    background: transparent;
    font-family: var(--font-display);
    font-size: 1.18rem;
    font-weight: 550;
    letter-spacing: -0.02em;
  }

  .search-input::placeholder {
    color: var(--ink-soft);
    opacity: 0.6;
    font-weight: 450;
  }

  .search-close {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink-soft);
    padding: 0.2rem;
  }

  .search-close:hover {
    color: var(--ink);
  }

  .search-close kbd {
    display: none;
    font-family: var(--font-ui);
    font-size: 0.6rem;
    padding: 0.12rem 0.3rem;
    border: 1px solid var(--line);
    border-radius: 2px;
  }

  .search-body {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 0.6rem 1.2rem;
    overscroll-behavior: contain;
  }

  .search-label {
    padding: 0.2rem 0.65rem 0.7rem;
    font-family: var(--font-ui);
    font-size: 0.62rem;
    font-weight: 650;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .search-results {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .search-empty {
    padding: 1.5rem 0.65rem 2rem;
    font-size: 0.95rem;
    color: var(--ink-soft);
    max-width: 46ch;
  }

  .search-empty a {
    color: var(--blue-deep);
    font-weight: 650;
  }

  .search-foot {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 1.1rem;
    border-top: 1px solid var(--line);
    background: var(--paper-deep);
    font-family: var(--font-ui);
    font-size: 0.63rem;
    color: var(--ink-soft);
  }

  .search-foot span {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .search-foot__brand {
    margin-left: auto;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .search-foot kbd {
    display: inline-grid;
    place-items: center;
    min-width: 1.1rem;
    height: 1.1rem;
    padding: 0 0.2rem;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    background: var(--paper-bright);
    font-family: var(--font-ui);
    font-size: 0.58rem;
  }

  :global(.search-result) {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 0.2rem 0.7rem;
    padding: 0.7rem 0.65rem;
    border-radius: 2px;
    text-decoration: none;
    border-left: 2px solid transparent;
  }

  :global(.search-result:hover),
  :global(.search-result.is-active) {
    background: var(--paper-bright);
    border-left-color: var(--blue);
  }

  :global(.search-result__kind) {
    grid-row: span 2;
    align-self: start;
    margin-top: 0.1rem;
    padding: 0.15rem 0.35rem;
    border: 1px solid var(--line-strong);
    font-family: var(--font-ui);
    font-size: 0.52rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  :global(.search-result__title) {
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 620;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  :global(.search-result__desc) {
    grid-column: 2;
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(.search-result__arrow) {
    grid-column: 3;
    grid-row: 1 / span 2;
    align-self: center;
    color: var(--ink-soft);
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  :global(.search-result.is-active .search-result__arrow),
  :global(.search-result:hover .search-result__arrow) {
    opacity: 1;
  }

  @media (min-width: 600px) {
    .search-close kbd {
      display: inline;
    }

    .search-body {
      padding: 1.2rem 0.8rem 1.5rem;
    }

    :global(.search-result) {
      padding: 0.8rem 0.8rem;
    }

    :global(.search-result__title) {
      font-size: 1.05rem;
    }
  }
</style>

<script>
  type SearchDoc = {
    kind: string;
    title: string;
    description: string;
    url: string;
    keywords?: string;
  };

  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const resultsEl = document.querySelector<HTMLElement>('[data-search-results]');
  const emptyEl = document.querySelector<HTMLElement>('[data-search-empty]');
  const queryEl = document.querySelector<HTMLElement>('[data-search-query]');
  const labelEl = document.querySelector<HTMLElement>('[data-search-label]');

  let docs: SearchDoc[] = [];
  let loaded = false;
  let loading: Promise<void> | null = null;
  let activeIndex = -1;
  let currentResults: SearchDoc[] = [];

  async function loadDocs() {
    if (loaded) return;
    if (loading) return loading;
    loading = fetch('/search.json')
      .then((res) => res.json())
      .then((data: { documents: SearchDoc[] }) => {
        docs = data.documents;
        loaded = true;
      })
      .catch(() => {
        docs = [];
        loaded = true;
      });
    return loading;
  }

  function score(doc: SearchDoc, terms: string[]) {
    const title = doc.title.toLowerCase();
    const description = doc.description.toLowerCase();
    const keywords = (doc.keywords ?? '').toLowerCase();
    let total = 0;
    for (const term of terms) {
      if (title.startsWith(term)) total += 8;
      else if (title.includes(term)) total += 5;
      if (keywords.includes(term)) total += 3;
      if (description.includes(term)) total += 2;
      if (!title.includes(term) && !keywords.includes(term) && !description.includes(term)) return 0;
    }
    if (doc.kind === 'Guide') total += 1.5;
    return total;
  }

  function render(doc: SearchDoc, index: number) {
    const active = index === activeIndex ? ' is-active' : '';
    return `<a class="search-result${active}" href="${doc.url}" role="option" aria-selected="${index === activeIndex}" data-index="${index}">
      <span class="search-result__kind">${doc.kind}</span>
      <span class="search-result__title">${doc.title}</span>
      <span class="search-result__desc">${doc.description}</span>
      <svg class="search-result__arrow" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
    </a>`;
  }

  function showResults(query: string) {
    if (!resultsEl || !emptyEl || !labelEl || !queryEl) return;
    const clean = query.trim().toLowerCase();

    if (!clean) {
      currentResults = docs.slice(0, 6);
      labelEl.textContent = 'Start here';
      emptyEl.hidden = true;
    } else {
      const terms = clean.split(/\s+/).filter(Boolean);
      currentResults = docs
        .map((doc) => ({ doc, score: score(doc, terms) }))
        .filter((item) => item.score > 0)
        .sort((a, b) => b.score - a.score)
        .slice(0, 9)
        .map((item) => item.doc);
      labelEl.textContent = currentResults.length
        ? `${currentResults.length} result${currentResults.length === 1 ? '' : 's'}`
        : 'No matches';
      emptyEl.hidden = currentResults.length > 0;
      queryEl.textContent = query.trim();
    }

    activeIndex = currentResults.length ? 0 : -1;
    resultsEl.innerHTML = currentResults.map(render).join('');
  }

  function move(delta: number) {
    if (!currentResults.length || !resultsEl) return;
    activeIndex = (activeIndex + delta + currentResults.length) % currentResults.length;
    resultsEl.querySelectorAll<HTMLElement>('.search-result').forEach((el, i) => {
      el.classList.toggle('is-active', i === activeIndex);
      el.setAttribute('aria-selected', String(i === activeIndex));
    });
    resultsEl.children[activeIndex]?.scrollIntoView({ block: 'nearest' });
  }

  function open() {
    if (!dialog) return;
    dialog.showModal();
    document.documentElement.style.overflow = 'hidden';
    loadDocs().then(() => {
      if (input && !input.value) showResults('');
      input?.focus();
    });
  }

  function close() {
    dialog?.close();
  }

  document.querySelectorAll('[data-search-open]').forEach((btn) => {
    btn.addEventListener('click', open);
  });

  document.querySelector('[data-search-close]')?.addEventListener('click', close);

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) close();
  });

  dialog?.addEventListener('close', () => {
    document.documentElement.style.overflow = '';
    if (input) input.value = '';
    activeIndex = -1;
  });

  input?.addEventListener('input', () => showResults(input.value));

  input?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      move(1);
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      move(-1);
    } else if (event.key === 'Enter') {
      const target = currentResults[activeIndex];
      if (target) {
        event.preventDefault();
        window.location.href = target.url;
      }
    }
  });

  document.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement;
    const typing = ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName) || target.isContentEditable;

    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      if (dialog?.open) close();
      else open();
    }

    if (event.key === '/' && !typing && !dialog?.open) {
      event.preventDefault();
      open();
    }
  });
</script>
